FROM docker.m.daocloud.io/library/python:3.11-slim

RUN pip install --no-cache-dir 'piper-tts[http,zh]==1.8.0'
RUN python -c "from transformers import AutoTokenizer; AutoTokenizer.from_pretrained('bert-base-chinese')"

ENV HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1

WORKDIR /models
COPY piper-start.py /opt/piper-start.py
EXPOSE 5000
CMD ["python", "/opt/piper-start.py"]
